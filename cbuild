#!/bin/bash

# Sintaxe: ./cbuild <comando> [opções]

export CMD_DIR="$PWD/cmd"

case "$1" in
	build)
		bash "$CMD_DIR/build.sh"
		;;
	run)
		bash "$CMD_DIR/run.sh"
		;;
	clean)
		bash "$CMD_DIR/clean.sh"
		;;
	rebuild)
		bash "$CMD_DIR/rebuild.sh"
		;;
	info)
		bash "$CMD_DIR/info.sh"
		;;
	*)
		# Erro: Comando inválido.
		bash "$CMD_DIR/errors.sh" 1
		exit 1
		;;
esac
